# Copy to env.properties (git-ignored) and fill in. In CI use real environment variables with the same names.
# NEVER put server secrets here (MongoDB, JWT signing secret, Click/Paynet, Cloudinary ...). The APK is public:
# everything in this file ends up inside it and can be extracted. Real protection is JWT + restaurantId on the backend.

# ---------------- RELEASE (production) ----------------
# A release build is REJECTED unless these point to https://restoran-api.lokma.uz (the BFF, lokmago-restaurant-backend) (see gradle/release-validation.gradle.kts).
API_GATEWAY_URL=https://restoran-api.lokma.uz
SOCKET_URL=https://restoran-api.lokma.uz
API_PATH_PREFIX=restaurant/v1/
SOCKET_PATH=/socket.io/
# Shared gateway header. NOT a secret once shipped in an APK; it is only a coarse filter in front of the API.
# Leave empty if the backend does not set GATEWAY_INBOUND_PASSWORD.
API_GATEWAY_HEADER=x-gateway-password
API_GATEWAY_PASSWORD=

# Must be set explicitly for every release. VERSION_CODE = previous + 1 (Google Play rejects a repeat).
VERSION_CODE=1
VERSION_NAME=1.0.0

# Signing. Keep the keystore OUTSIDE the repository (scripts/generate-keystore.sh creates one in ~/.lokmago-signing).
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# ---------------- DEBUG only (never read by release builds) ----------------
# Point debug builds at a test server. If DEBUG_API_GATEWAY_URL is set and DEBUG_SOCKET_URL is not,
# the socket host is derived from DEBUG_API_GATEWAY_URL.
# DEBUG_API_GATEWAY_URL=https://api-test.example.com
# DEBUG_SOCKET_URL=
# DEBUG_API_GATEWAY_PASSWORD=
