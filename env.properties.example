# Copy to env.properties (git-ignored) and fill in. In CI use real environment variables with the same names.
# NEVER put server secrets here (MongoDB, JWT signing secret, Click/Paynet, Cloudinary ...). The APK is public:
# everything in this file ends up inside it and can be extracted. Real protection is the restaurant's JWT
# (same login + password as the admin panel) and restaurantId taken from that JWT on the server.

# ---------------- RELEASE (production) ----------------
# The app talks DIRECTLY to lakmago-server — the same API the admin panel uses (no gateway, no BFF).
# A release build is REJECTED unless API_URL/SOCKET_URL point to https://<PROD_API_HOST> (gradle/release-validation.gradle.kts).
# Do NOT use a host listed in the server's J_ROUTE_HOSTS (that host only serves the menu export and returns 404 for /api).
PROD_API_HOST=apilokma.poppolizol.uz
API_URL=https://apilokma.poppolizol.uz
SOCKET_URL=https://apilokma.poppolizol.uz
API_PATH_PREFIX=api/
SOCKET_PATH=/socket.io/

# Must be set explicitly for every release. VERSION_CODE = previous + 1 (Google Play rejects a repeat).
VERSION_CODE=1
VERSION_NAME=1.0.0

# Signing. Keep the keystore OUTSIDE the repository (scripts/generate-keystore.sh creates one in ~/.lokmago-signing).
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=

# ---------------- DEBUG only (never read by release builds) ----------------
# Point debug builds at a test server (e.g. a local lakmago-server). If DEBUG_API_URL is set and DEBUG_SOCKET_URL
# is not, the socket host is derived from DEBUG_API_URL.
# DEBUG_API_URL=https://api-test.example.com
# DEBUG_SOCKET_URL=
