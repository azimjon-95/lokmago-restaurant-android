# Copy to env.properties (git-ignored) and fill in. In CI use real environment variables with the same names.
API_GATEWAY_URL=https://gateway.lokmago.uz/
API_GATEWAY_PASSWORD=change-me
API_GATEWAY_HEADER=x-gateway-password
API_PATH_PREFIX=restaurant/v1/
# Optional: if Socket.IO lives on a different host. Empty => same host as API_GATEWAY_URL
SOCKET_URL=
SOCKET_PATH=/socket.io/

# Release build
VERSION_CODE=1
VERSION_NAME=1.0.0
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
